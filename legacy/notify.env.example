# notify.js 설정. 이 파일을 notify.env 로 복사해서 값을 채운다.
#   cp notify.env.example notify.env && chmod 600 notify.env
# notify.env 는 .gitignore 에 있고 배포(rsync)에서도 제외된다.

# ── Gmail SMTP ──────────────────────────────────────────────────────────────
# 앱 비밀번호는 일반 계정 비밀번호가 아니다. 2단계 인증을 켠 뒤
# https://myaccount.google.com/apppasswords 에서 16자리를 발급받는다.
# (공백 없이 붙여서 넣어도 되고, 공백이 있어도 Gmail 이 받아준다)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=보내는계정@gmail.com
SMTP_PASS=앱비밀번호16자리

# 보내는 사람. 비우면 SMTP_USER 를 쓴다.
# Gmail 은 계정 소유가 아닌 주소로는 발송을 거부한다.
MAIL_FROM=

# 받는 사람. 쉼표로 여러 명.
MAIL_TO=받는사람@example.com

# 용도별로 나누고 싶으면 아래를 채운다. 비워두면 둘 다 MAIL_TO 를 쓴다.
#   일일 리포트에는 잔액이 들어가고, 장애 알림에는 안 들어간다.
#   그래서 공유 범위가 달라질 수 있다.
MAIL_TO_DAILY=
MAIL_TO_ALERT=

# ── 대상 ────────────────────────────────────────────────────────────────────
# 서버 안에서 직접 부르는 주소. 로컬로 부르면 상세 정보까지 받을 수 있다.
APP_URL=http://127.0.0.1:8787
# 메일 하단에 넣을 공개 링크
PUBLIC_URL=https://dashboard.example.com

# 장애가 이어질 때 같은 알림을 다시 보내기까지의 간격(분)
ALERT_COOLDOWN_MIN=60
